# Environment variables required by the skapp-pm backend.
# These are set in docker-compose.ci.yml for CI runs.
# Copy this to .env and fill in values for local development.

# ---------- Database ----------
TENANT_DATABASE_WRITE_URL=postgresql://test:test@localhost:5432/skapp_pm_test
TENANT_DATABASE_READ_URL=postgresql://test:test@localhost:5432/skapp_pm_test
DB_SSL=false
USE_DB_SSL=false

# ---------- Redis ----------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_MODE=standalone
REDIS_TLS=false

# ---------- Server ----------
PORT=3000
NODE_ENV=test
API_BASE_URL=http://localhost:3000

# ---------- Auth ----------
SIGN_IN_KEY=e2e-test-sign-in-key-at-least-32-chars-long!!
INTERNAL_API_KEY=e2e-test-internal-api-key
HEALTH_API_KEY=e2e-test-health-api-key

# ---------- Core API ----------
CORE_API_URL=http://localhost:9999
CORE_GET_EMPLOYEES_API_URL=/api/v1/employees
CORE_GET_EMPLOYEES_AUTH_PICS_API_URL=/api/v1/employees/auth-pics
CORE_GET_VERSIONS_API_URL=/api/v1/versions
CORE_GET_JOBS_API_URL=/api/v1/jobs
CORE_INTERNAL_API_KEY=e2e-test-core-internal-key

# ---------- Email (dummy) ----------
SENDGRID_API_KEY=SG.e2e-test-dummy-key
SENDGRID_FROM_EMAIL=test@example.com
DEFAULT_EMAIL_BUTTON_URL=http://localhost:3000

# ---------- AWS S3 (dummy) ----------
AWS_CORE_BUCKET_NAME=e2e-core-bucket
AWS_PM_BUCKET_NAME=e2e-pm-bucket
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=AKIAE2ETESTDUMMY
AWS_SECRET_ACCESS_KEY=e2e-test-dummy-secret-key

# ---------- Jira (dummy) ----------
JIRA_CLIENT_ID=e2e-test-jira-client-id
JIRA_CLIENT_SECRET=e2e-test-jira-client-secret

# ---------- OpenSearch (dummy) ----------
OPENSEARCH_NODE=http://localhost:9200
OPENSEARCH_USERNAME=admin
OPENSEARCH_PASSWORD=admin
OPENSEARCH_SSL_REJECT_UNAUTHORIZED=false

# ---------- AI ----------
AI_API_KEY=e2e-test-ai-api-key
